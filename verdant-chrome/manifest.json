{
  "manifest_version": 3,
  "name": "V.E.R.D.A.N.T. - Autonomous Bug Runtime",
  "version": "2.5.0",
  "description": "Autonomous multimodal bug runtime with client-side PII scrubbing, visual layout inspection, real-time DOM & console crawling, in-tab hot-patching, and VS Code IDE bridge.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/page_interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/pii_scrubber.js",
        "src/visual_crawler.js",
        "src/in_tab_patcher.js",
        "drawer.js",
        "content.js"
      ],
      "css": ["drawer.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "V.E.R.D.A.N.T. Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/page_interceptor.js",
        "drawer.js",
        "drawer.css",
        "src/visual_crawler.js",
        "src/in_tab_patcher.js",
        "src/pii_scrubber.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
